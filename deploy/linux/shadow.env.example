# Directory containing StraddleTargetProbe session folders.
TARGET_PROBE_ROOT=/home/ubuntu/straddle-target-probe

# Use "observer" for best-effort accepted-state synchronization. Change to
# "probe" only when the passive probe runs in the originating target terminal.
TARGET_SOURCE=observer
TARGET_OBSERVER_ROOT=/home/ubuntu/straddle-data/python
OBSERVER_ADAPTER_STATE=/home/ubuntu/straddle-live-twin/state/observer-adapter.json

# FILE_COMMON root for the isolated Achiever shadow terminal.
SHADOW_COMMON_ROOT=/home/ubuntu/.wine-straddle-shadow/drive_c/users/ubuntu/AppData/Roaming/MetaQuotes/Terminal/Common/Files

# Keep 0 for observation-only commissioning. Change to 1 only after validation.
SHADOW_ACTIVE=0

STATE_ROOT=/home/ubuntu/straddle-live-twin/state
DATA_ROOT=/home/ubuntu/straddle-live-twin/data
OUTPUT_ROOT=/home/ubuntu/straddle-live-twin/reports
ACCOUNT_TERMS_REPORT=/home/ubuntu/straddle-live-twin/reports/commissioning/account-terms-901018-vs-901111.json
COMMISSIONING_GUARD_REPORT=/home/ubuntu/straddle-live-twin/state/commissioning-guard.json

# Active files included in the certification fingerprint.
PACKAGE_ROOT=/home/ubuntu/straddle-live-twin/package
SHADOW_EA_PATH=/home/ubuntu/mt5-straddle-shadow/MQL5/Experts/StraddleReplica/StraddleReplica.ex5
SHADOW_PROFILE_PATH=/home/ubuntu/straddle-live-twin/latest_30_shadow.set
SHADOW_STARTUP_PATH=/home/ubuntu/straddle-live-twin/shadow-startup.ini
EXPECTED_PROBE_BUILD_ID=latest30-live-twin-v1
