[Unit]
Description=Daily Straddle target-versus-demo comparison
After=straddle-python.service straddle-demo-mt5.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=96M
MemoryMax=192M
ExecStart=/home/ubuntu/straddle-monitor/bin/run_demo_analysis.sh
